# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string used to sign access tokens (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Short-lived access token (JWT), in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Long-lived refresh token (stored hashed in the database, sent as an HttpOnly cookie), in days
REFRESH_TOKEN_EXPIRE_DAYS=7
# Password reset links: valid this many minutes, point at the front end below
PASSWORD_RESET_EXPIRE_MINUTES=30
FRONTEND_URL=http://localhost:5173
# Email for reset links. Leave SMTP_HOST empty in development: the link is printed in the server log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
# Set to true when the API is served over HTTPS so the refresh cookie is marked Secure
COOKIE_SECURE=false
