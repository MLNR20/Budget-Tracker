# Copy to .env and fill in. .env is git-ignored; never commit real credentials.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
# Long random string used to sign access tokens (python -c "import secrets; print(secrets.token_urlsafe(48))")
SECRET_KEY=
# Short-lived access token (JWT), in minutes
ACCESS_TOKEN_EXPIRE_MINUTES=15
# Long-lived refresh token (stored hashed in the database, sent as an HttpOnly cookie), in days
REFRESH_TOKEN_EXPIRE_DAYS=7
# Set to true when the API is served over HTTPS so the refresh cookie is marked Secure
COOKIE_SECURE=false
